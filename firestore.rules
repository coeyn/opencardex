rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isFriendReader(ownerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(ownerUid));
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if isOwner(uid);
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid}/friends/{friendUid} {
      allow read, write, delete: if isOwner(uid);
    }

    match /users/{uid}/binders/{binderId} {
      allow read: if isOwner(uid) || isFriendReader(uid);
      allow write, delete: if isOwner(uid);
    }

    match /users/{uid}/ownedCards/{ownedCardId} {
      allow read: if isOwner(uid) || isFriendReader(uid);
      allow write, delete: if isOwner(uid);
    }

    match /users/{uid}/backups/{backupId} {
      allow read, write, delete: if isOwner(uid);
    }
  }
}
